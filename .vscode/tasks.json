{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "星图智课：启动 Web 与移动端演示",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --port 5174",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      }
    }
  ]
}
